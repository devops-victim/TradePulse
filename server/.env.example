PORT=4000
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/tradepulse
BSE_API_BASE_URL=http://localhost:4001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
PG_POOL_MAX=12
# Local server: disable. Cloud: verify-full (default for non-local hosts).
PG_SSL_MODE=disable
# PG_SSL_CA_FILE=/path/to/provider-root-ca.pem
BSE_API_TOKEN=
BSE_REQUEST_TIMEOUT_MS=20000
INGESTION_BATCH_SIZE=500
# manual explicitly means automatic source completion is not yet configured.
BSE_COMPLETION_MODE=manual
# For automatic completion, set webhook and configure both values below.
# First implement docs/BSE-SERVICE-FIX-PROMPT.md on the independent BSE service.
# Local: http://localhost:4000/api/bse/notifications
# Cloud: https://YOUR_TRADEPULSE_BACKEND/api/bse/notifications
BSE_CALLBACK_URL=
# Random secret of at least 32 characters, also configured on BSE (never in payloads).
BSE_WEBHOOK_SECRET=
# Enable only when the external POST /extractions honors Idempotency-Key.
BSE_SUPPORTS_IDEMPOTENCY=false
